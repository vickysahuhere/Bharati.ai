# --- college instance secrets (never commit .env) ---
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://camp:change-me@db:5432/camp
SECRET_KEY=generate-with-openssl-rand-hex-32
DATA_DIR=/data

# --- providers (all free tier) ---
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# --- bootstrap owner (created on first start, M1) ---
OWNER_EMAIL=owner@college.example
OWNER_PASSWORD=change-me-too

COLLEGE_CONFIG=/config/college.yaml
